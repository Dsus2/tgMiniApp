# Yandex Maps JavaScript API key — powers the "выбрать на карте" address
# picker (src/components/AddressMapPicker.tsx). Free to register at
# yandex.ru/dev/maps ("JavaScript API и HTTP Геокодер"). This key is meant
# to be public (restricted by HTTP referrer on Yandex's side, same model as
# Google Maps JS keys) — safe to ship in client code, unlike the server's
# other secrets.
VITE_YANDEX_MAPS_API_KEY=
