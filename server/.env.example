PORT=4000

# When true: no real YooKassa payment is created and no real order ever
# reaches iiko — the whole payment + order flow is emulated with fake data
# (see src/mockFlow.js). Set to false only when ready to take real orders.
TEST_MODE=true

# The already-running iikoGate gateway — this server only calls it over
# HTTPS; nothing here touches the gateway's own deploy.
GATEWAY_BASE_URL=https://sb02-security.ru
GATEWAY_API_KEY=
ORGANIZATION_ID=

# This Mini App build is scoped to one branch — its terminal group id and
# its "YCAS" payment type id (see GET /v1/organizations/:id/payment-types
# and /terminal-groups on the gateway above).
TERMINAL_GROUP_ID=
YCAS_PAYMENT_TYPE_ID=
# A 0₽-by-default technical product used to carry the delivery fee as an
# explicit per-order price override (see src/cartStore.js finalizeOrder).
DELIVERY_FEE_PRODUCT_ID=

# Vite dev server origin, so the browser's fetch() to this API isn't blocked by CORS.
CLIENT_ORIGIN=http://localhost:5173

# Where the customer lands after paying on YooKassa's hosted page.
RETURN_URL=https://t.me/your_bot_username

# GigaChat (Sber) — powers the in-app AI chat (src/agent.js). Basic-auth key
# from developers.sber.ru.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# YooKassa — real production keys. Creating a payment here does not move any
# money by itself; nothing is charged until the customer completes it on
# YooKassa's own hosted page.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Same bot token as iikoGate-bot/.env — verifies the Telegram WebApp
# initData every cart/chat request carries (see src/telegramAuth.js), so a
# session id can't just be invented by whoever calls the API. Required
# outside TEST_MODE.
BOT_TOKEN=
